  "info": [
    { "label": "Keychron protocol", "field": "protocolVersion", "text": "{value}" },
    { "label": "NKRO", "field": "nkro" },
    { "label": "Adaptive NKRO", "field": "nkroAdaptive" },
    { "label": "Snap click pairs on the board", "field": "snapPairs", "text": "{value} (the first 4 are offered here)" },
    { "label": "Report rate divider", "field": "reportDivider", "text": "{value} (0 = 8000 Hz, 1 = 4000, 3 = 1000; others unconfirmed)" }
  ],
  "stepBack": { "processes": ["^keychron.*\\.exe$", "^via\\.exe$"],
    "note": "sheet section 4 'Never': do not run beside Keychron Launcher or usevia.app. Both are usually a browser tab, which a process list cannot see: close them before changing settings here. The process names are not from a source." },
