{
  "format": 1,
  "id": "asus-rog-mouse",
  "title": "ASUS ROG mouse",
  "kind": "Mouse",
  "vendor": "ASUS",
  "about": "The ASUS ROG mouse library driver (device.mjs beside it) written as data, 22 Oct 2026. Same bytes, same values: tests/declarative-driver.mjs runs both against the simulated mouse. Every byte comes from docs/brands/asus-rog.md (G-Helper, libratbag, OpenRGB facts); byte offsets here count from 0 at the first data byte after the report id (the sheet counts the report id as byte 0, so sheet byte n = offset n-1).",
  "source": "docs/brands/asus-rog.md",
  "vid": "0B05",
  "pids": ["1A92", "1A94", "1A66", "1A68", "197B", "197D", "197F", "1A70", "1A72", "1A18", "1A1A", "1ACE"],
  "hid": { "vid": "0B05", "pid": "1A92", "pids": ["1A92", "1A94", "1A66", "1A68", "197B", "197D", "197F", "1A70", "1A72", "1A18", "1A1A", "1ACE"], "page": "FF01", "len": 64, "reportId": 0, "replyMs": 300,
    "paths": { "cable": "mi_00", "dongle": "mi_00", "omniPairing": "mi_02&col01", "omniMouse": "mi_02&col03" } },
  "transport": { "report": "output", "len": 64, "reportId": 0, "usagePage": "FF01", "timeoutMs": 600, "tries": 3,
    "note": "sheet section 5: G-Helper's 300 ms and 3 tries, plus the helper's wait" },
  "links": {
    "cable": { "label": "USB cable", "reportId": 0, "wireless": false },
    "dongle": { "label": "its own 2.4 GHz receiver", "reportId": 0, "wireless": true },
    "omni": { "label": "ROG Omni receiver", "reportId": 3, "wireless": true, "usagePage": null, "pids": ["1ACE"],
      "note": "sheet section 2: pair list on report 01 (mi_02&col01), the mouse on report 03 (mi_02&col03)",
      "identify": { "message": "pairList", "list": { "offset": 4, "stride": 4, "size": 2, "endian": "little", "stopAt": 0 },
        "refused": "the Omni receiver refused its pair-list read (FF AA)" },
      "probes": [ { "name": "booster", "message": "booster", "field": { "offset": 4, "map": { "1": true }, "default": false },
        "note": "sheet section 2: booster probe, byte 5 = 01 means on" } ] }
  },
  "models": [
    { "key": "harpe-ace-aim-lab", "name": "ROG Harpe Ace Aim Lab Edition", "pids": { "cable": ["1A92"], "dongle": ["1A94"] }, "paired": { "omni": ["1A94"] }, "vars": { "battery": true, "dpiMax": 36000 } },
    { "key": "keris-wireless-aimpoint", "name": "ROG Keris Wireless AimPoint", "pids": { "cable": ["1A66"], "dongle": ["1A68"] }, "paired": { "omni": ["1A68", "1A6A"] }, "vars": { "battery": true, "dpiMax": 36000 } },
    { "key": "gladius-iii", "name": "ROG Gladius III", "pids": { "cable": ["197B"] }, "vars": { "battery": false, "dpiMax": 19000 } },
    { "key": "gladius-iii-wireless", "name": "ROG Gladius III Wireless", "pids": { "cable": ["197D"], "dongle": ["197F"] }, "vars": { "battery": true, "dpiMax": 19000 } },
    { "key": "gladius-iii-wireless-aimpoint", "name": "ROG Gladius III Wireless AimPoint", "pids": { "cable": ["1A70"], "dongle": ["1A72"] }, "paired": { "omni": ["1A72"] }, "vars": { "battery": true, "dpiMax": 36000 } },
    { "key": "chakram-x", "name": "ROG Chakram X", "pids": { "cable": ["1A18"], "dongle": ["1A1A"] }, "vars": { "battery": true, "dpiMax": 36000, "doubleDpi": true, "pollingCable": true },
      "note": "doubleDpi: libratbag doubles its DPI and G-Helper does not, so DPI stays read only; pollingCable: up to 8000 Hz on its cable (sheet section 4)" }
  ],
  "replies": { "echo": [0, 1], "error": { "bytes": "FF AA" },
    "note": "a reply repeats verb + subcommand; FF AA = refused, or asleep on a wireless link (sheet section 2)" },
  "messages": {
    "status": { "bytes": "12 07", "note": "sheet: battery level, charging, sleep, low-battery warning" },
    "profile": { "bytes": "12 04 00", "note": "sheet: DPI stages, polling rate, button response, angle snapping" },
    "colors": { "bytes": "12 04 03", "note": "sheet: DPI stage colors, sent back unchanged with a DPI write" },
    "liftOffRead": { "bytes": "12 06", "note": "sheet: lift-off distance" },
    "save": { "bytes": "50 03", "note": "sheet: save, sent after each change" },
    "pairList": { "bytes": "A0 00 00", "reportId": 1, "note": "sheet section 2: Omni pair list" },
    "booster": { "bytes": "7D 20 02", "note": "sheet section 2: booster probe, read only" },
    "setDpi1": { "bytes": "51 31 00 00 {value:u16le} {dpi1Color?}" },
    "setDpi2": { "bytes": "51 31 01 00 {value:u16le} {dpi2Color?}" },
    "setDpi3": { "bytes": "51 31 02 00 {value:u16le} {dpi3Color?}" },
    "setDpi4": { "bytes": "51 31 03 00 {value:u16le} {dpi4Color?}" },
    "setPolling": { "bytes": "51 31 04 00 {value}" },
    "setAngleSnap": { "bytes": "51 31 06 00 {value}" },
    "setSleep": { "bytes": "51 37 00 00 {value} 00 {lowBattery}", "note": "the low-battery warning is sent back as it was read" },
    "setLiftOff": { "bytes": "51 35 FF 00 FF {value}" },
    "profileRead": { "bytes": "12 00", "note": "sheet: Profile read (G-Helper, libratbag); the same 'profile reply' holds the DPI stage count at sheet byte 19 (G-Helper)" },
    "setStageCount": { "bytes": "51 31 0A 00 {value}", "note": "sheet: DPI stage count 00 51 31 0A 00 <2-4> (G-Helper)" },
    "setProfile": { "bytes": "50 02 {value}", "note": "sheet: Profile 00 50 02 <p>, 0-based (G-Helper, libratbag): select only, no profile block is written" }
  },
  "reads": [
    { "name": "status", "message": "status", "when": { "model.battery": true }, "onError": { "wireless": "fail", "wired": "skip" },
      "asleepIf": { "link.wireless": true, "battery": 0, "charging": false }, "note": "sheet section 2 'Sleep and disconnect': 0% and not charging = not ready" },
    { "name": "profile", "message": "profile", "onError": "fail" },
    { "name": "liftOff", "message": "liftOffRead", "onError": "skip" },
    { "name": "profileInfo", "message": "profileRead", "onError": "skip" },
    { "name": "colors", "message": "colors", "onDemand": true, "onError": "skip" }
  ],
  "fields": {
    "battery": { "from": "status", "offset": 4 },
    "sleep": { "from": "status", "offset": 5, "map": { "0": 1, "1": 2, "2": 3, "3": 5, "4": 10, "255": 0 }, "note": "minutes; 0 = never (code FF)" },
    "lowBattery": { "from": "status", "offset": 6 },
    "charging": { "from": "status", "offset": 9, "type": "bool" },
    "dpi1": { "from": "profile", "offset": 4, "size": 2, "endian": "little", "absentIf": 0, "scale": 50, "add": 50 },
    "dpi2": { "from": "profile", "offset": 6, "size": 2, "endian": "little", "absentIf": 0, "scale": 50, "add": 50 },
    "dpi3": { "from": "profile", "offset": 8, "size": 2, "endian": "little", "absentIf": 0, "scale": 50, "add": 50 },
    "dpi4": { "from": "profile", "offset": 10, "size": 2, "endian": "little", "absentIf": 0, "scale": 50, "add": 50 },
    "pollingHigh": { "from": "profile", "offset": 12, "shift": 4, "note": "the high nibble: the 8K booster's, undocumented" },
    "pollingRate": { "from": "profile", "offset": 12, "mask": 7, "map": { "0": 125, "1": 250, "2": 500, "3": 1000, "4": 2000, "5": 4000, "6": 8000 },
      "when": { "pollingHigh": 0, "probe.booster": { "not": true } } },
    "debounce": { "from": "profile", "offset": 14, "note": "button response: G-Helper's and libratbag's tables disagree, so read only" },
    "angleSnap": { "from": "profile", "offset": 16, "map": { "1": true }, "default": false },
    "liftOff": { "from": "liftOff", "offset": 7, "map": { "0": "low", "1": "high" } },
    "onboardProfile": { "from": "profileInfo", "offset": 10, "map": { "0": 1, "1": 2, "2": 3, "3": 4, "4": 5 }, "note": "sheet: Profile (1-5) byte 11, 0-based" },
    "stageCount": { "from": "profileInfo", "offset": 18, "map": { "2": 2, "3": 3, "4": 4 }, "note": "sheet: DPI stage count byte 19, 2-4; anything else = not reported" },
    "dpi1Color": { "from": "colors", "offset": 4, "size": 3, "type": "bytes" },
    "dpi2Color": { "from": "colors", "offset": 7, "size": 3, "type": "bytes" },
    "dpi3Color": { "from": "colors", "offset": 10, "size": 3, "type": "bytes" },
    "dpi4Color": { "from": "colors", "offset": 13, "size": 3, "type": "bytes" }
  },
  "settings": [
    { "key": "dpi1", "label": "DPI stage 1", "type": "slider", "min": 100, "max": "$model.dpiMax", "step": 50, "unit": " DPI", "when": { "model.doubleDpi": { "not": true } }, "lockGroup": "dpi",
      "write": { "message": "setDpi1", "needs": ["colors"], "then": "save" } },
    { "key": "dpi2", "label": "DPI stage 2", "type": "slider", "min": 100, "max": "$model.dpiMax", "step": 50, "unit": " DPI", "when": { "model.doubleDpi": { "not": true } }, "lockGroup": "dpi",
      "write": { "message": "setDpi2", "needs": ["colors"], "then": "save" } },
    { "key": "dpi3", "label": "DPI stage 3", "type": "slider", "min": 100, "max": "$model.dpiMax", "step": 50, "unit": " DPI", "when": { "model.doubleDpi": { "not": true } }, "lockGroup": "dpi",
      "write": { "message": "setDpi3", "needs": ["colors"], "then": "save" } },
    { "key": "dpi4", "label": "DPI stage 4", "type": "slider", "min": 100, "max": "$model.dpiMax", "step": 50, "unit": " DPI", "when": { "model.doubleDpi": { "not": true } }, "lockGroup": "dpi",
      "write": { "message": "setDpi4", "needs": ["colors"], "then": "save" } },
    { "key": "pollingRate", "label": "Polling rate", "type": "choice", "when": { "link.name": "cable", "model.pollingCable": true },
      "options": [ { "value": 125, "label": "125 Hz" }, { "value": 250, "label": "250 Hz" }, { "value": 500, "label": "500 Hz" }, { "value": 1000, "label": "1K Hz" },
        { "value": 2000, "label": "2K Hz" }, { "value": 4000, "label": "4K Hz" }, { "value": 8000, "label": "8K Hz" } ],
      "write": { "message": "setPolling", "then": "save" } },
    { "key": "pollingRate", "label": "Polling rate", "type": "choice", "when": { "probe.booster": { "not": true } },
      "options": [ { "value": 125, "label": "125 Hz" }, { "value": 250, "label": "250 Hz" }, { "value": 500, "label": "500 Hz" }, { "value": 1000, "label": "1K Hz" } ],
      "write": { "message": "setPolling", "then": "save" } },
    { "key": "angleSnap", "label": "Angle snapping", "type": "toggle",
      "write": { "message": "setAngleSnap", "then": "save", "encode": { "map": { "false": 0, "true": 1 } } } },
    { "key": "liftOff", "label": "Lift-off distance", "type": "choice", "options": [ { "value": "low", "label": "Low" }, { "value": "high", "label": "High" } ],
      "hint": "Changing it also resets the sensor's surface calibration.",
      "write": { "message": "setLiftOff", "then": "save" } },
    { "key": "sleep", "label": "Sleep after", "type": "choice", "when": { "model.battery": true },
      "options": [ { "value": 1, "label": "1 min" }, { "value": 2, "label": "2 min" }, { "value": 3, "label": "3 min" }, { "value": 5, "label": "5 min" }, { "value": 10, "label": "10 min" }, { "value": 0, "label": "Never" } ],
      "write": { "message": "setSleep", "then": "save", "keep": ["lowBattery"] } },
    { "key": "stageCount", "label": "DPI stages in use", "type": "choice", "options": [ { "value": 2, "label": "2" }, { "value": 3, "label": "3" }, { "value": 4, "label": "4" } ],
      "write": { "message": "setStageCount", "then": "save" } },
    { "key": "onboardProfile", "label": "Onboard profile", "type": "choice",
      "options": [ { "value": 1, "label": "Profile 1" }, { "value": 2, "label": "Profile 2" }, { "value": 3, "label": "Profile 3" }, { "value": 4, "label": "Profile 4" }, { "value": 5, "label": "Profile 5" } ],
      "hint": "Switches to a profile saved on the mouse; DPI and the other settings then read from that profile.",
      "write": { "message": "setProfile", "note": "50 02 is itself the action: no save after it" } }
  ],
  "battery": { "from": "status", "percent": "battery", "charging": "charging", "when": { "model.battery": true }, "awake": true },
  "info": [
    { "label": "Button response", "field": "debounce", "text": "code {value} (read only: G-Helper's and libratbag's tables disagree)" },
    { "label": "8K booster", "field": "probe.booster", "when": { "link.name": "omni" }, "map": { "true": "on (polling shown read only)", "false": "off", "null": "unknown (the probe was refused)" } }
  ],
  "stepBack": { "processes": ["^armourycrate.*\\.exe$", "^ghelper\\.exe$"], "note": "sheet section 4: step back while Armoury Crate or G-Helper runs" },
  "unsupported": ["firmware updates", "Omni receiver pairing", "button remaps", "lights (OpenRGB has them)", "button response and the 8K booster (read only: the sources disagree)", "active DPI stage, angle tuning, low-battery warning, DPI stage colors (not yet: see docs/handoff/driver-coverage.md)"],
  "never": [
    { "bytes": "51 21", "why": "button remap (sheet section 4 'Never')" },
    { "bytes": "51 22", "why": "rapid fire remap (sheet section 4 'Never')" },
    { "bytes": "51 23", "why": "button remap (sheet section 4 'Never')" },
    { "bytes": "51 28", "why": "mouse lights (OpenRGB has them)" },
    { "bytes": "51 29", "why": "mouse per-LED lights (OpenRGB has them)" }
  ]
}
