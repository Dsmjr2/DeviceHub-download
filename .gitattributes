# Windows' batch and script files need Windows line endings: with Unix ones cmd loses its place after a call or goto
# (20 Oct 2026: keep-running.bat stopped after 'call :now')
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
# the Wi-Fi pause script is pinned by its SHA-256 (helpers/wifi-pause.mjs): its bytes must never change on checkout
helpers/wifi-pause.ps1 -text
